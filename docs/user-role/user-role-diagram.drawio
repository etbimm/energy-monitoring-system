<mxfile host="app.diagrams.net" type="device"><diagram id="user-role" name="User Role Diagram"><mxGraphModel dx="1500" dy="1215" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1215" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="User Role Diagram (Use Case) — Energy Monitoring System" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=17;fontFamily=Arial;fontColor=#0B3D6E;" vertex="1" parent="1"><mxGeometry x="0" y="4" width="1500" height="28" as="geometry"/></mxCell><mxCell id="system" value="Energy Monitoring System — Web Dashboard Java Wood Pellet" style="swimlane;html=1;startSize=40;fillColor=#0B3D6E;swimlaneFillColor=#FFFFFF;strokeColor=#0B3D6E;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Arial;container=0;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="1060" height="960" as="geometry"/></mxCell><mxCell id="pkg_view" value="Monitoring (Viewer &amp; Admin)" style="rounded=1;arcSize=2;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#1F4E79;fontColor=#1F4E79;fontStyle=1;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="235" y="95" width="400" height="880" as="geometry"/></mxCell><mxCell id="pkg_admin" value="Administrasi (khusus Admin)" style="rounded=1;arcSize=2;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#22A699;fontColor=#22A699;fontStyle=1;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="665" y="95" width="560" height="880" as="geometry"/></mxCell><mxCell id="uc_login" value="Login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E4EDF8;strokeColor=#1F4E79;fontSize=13;fontFamily=Arial;fontColor=#0B3D6E;" vertex="1" parent="1"><mxGeometry x="275" y="145" width="320" height="58" as="geometry"/></mxCell><mxCell id="uc_logout" value="Logout" sty