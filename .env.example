# ===== Copy file ini jadi .env lalu sesuaikan =====
# JANGAN commit file .env yang berisi password asli

# --- Database ---
POSTGRES_USER= #ems
POSTGRES_PASSWORD= #ems
POSTGRES_DB= #ems
POSTGRES_PORT=#5432
DATABASE_URL=#postgresql+asyncpg://ems:ems@localhost:5432/ems
REDIS_URL=#redis://localhost:6379/0

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=#localhost
MQTT_PORT=#1883
# Broker hanya dipublikasikan ke loopback secara default. Jangan ubah ke
# alamat jaringan tanpa menyiapkan TLS pada listener Mosquitto terlebih dahulu.
MQTT_BIND_ADDRESS=#127.0.0.1
# Wajib berbeda dan kuat; backend/acquisition/healthcheck punya akun terpisah.
MQTT_BACKEND_PASSWORD=
MQTT_ACQUISITION_PASSWORD=
MQTT_HEALTH_PASSWORD=

# --- Backend API ---
BACKEND_PORT=#4000
CORS_ORIGINS=#http://localhost:3000,http://127.0.0.1:3000

# --- Login (sesi JWT di cookie httpOnly) ---
# production = backend MENOLAK start bila JWT_SECRET kosong (disarankan).
# development = secret acak sementara dibuat saat start (sesi hilang saat restart).
ENVIRONMENT=production
# WAJIB diisi string acak >= 32 karakter, mis. hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Di production, backend gagal start bila nilai ini kosong.
JWT_SECRET=
# Lama sesi login (menit). 480 = 8 jam / satu shift.
JWT_EXPIRE_MINUTES=480
# true bila dashboard diakses lewat HTTPS.
COOKIE_SECURE=false

# --- Frontend ---
FRONTEND_PORT=#3000

# --- Akuisisi Modbus ---
# simulator = payload sintetis ke MQTT (tanpa hardware)
# modbus    = poll meter via pymodbus TCP
ACQUISITION_MODE=#simulator
POLL_INTERVAL=#5
MODBUS_TIMEOUT=#2
