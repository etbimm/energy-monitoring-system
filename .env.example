# ===== Copy file ini jadi .env lalu sesuaikan =====
# JANGAN commit file .env yang berisi password asli

# --- Database ---
POSTGRES_USER=ems
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=ems
POSTGRES_PORT=5432

# --- MQTT Broker ---
MQTT_PORT=1883
MQTT_USERNAME=ems
MQTT_PASSWORD=ganti_password_ini

# --- Backend API ---
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=3000

# --- Node-RED ---
NODE_RED_PORT=1880

# --- Tarif listrik (Rp per kWh), dipakai untuk estimasi biaya ---
TARIFF_PER_KWH=1400

# --- Interval polling meter (detik) ---
POLL_INTERVAL=5