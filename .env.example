# ===== Copy file ini jadi .env lalu sesuaikan =====
# JANGAN commit file .env yang berisi password asli

# --- Database ---
POSTGRES_USER= #ems
POSTGRES_PASSWORD= #ems
POSTGRES_DB= #ems
POSTGRES_PORT=#5432
DATABASE_URL=#postgresql+asyncpg://ems:ems@localhost:5432/ems

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=#localhost
MQTT_PORT=#1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Backend API ---
BACKEND_PORT=#4000
CORS_ORIGINS=#http://localhost:3000,http://127.0.0.1:3000

# --- Login (sesi JWT di cookie httpOnly) ---
# WAJIB diisi string acak >= 32 karakter, mis. hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bila kosong, secret acak dibuat tiap start (semua user ter-logout saat restart).
JWT_SECRET=
# Lama sesi login (menit). 480 = 8 jam / satu shift.
JWT_EXPIRE_MINUTES=480
# true bila dashboard diakses lewat HTTPS.
COOKIE_SECURE=false

# --- Frontend ---
FRONTEND_PORT=#3000

# --- Akuisisi Modbus ---
# simulator = payload sintetis ke MQTT (tanpa hardware)
# modbus    = poll meter via pymodbus TCP
ACQUISITION_MODE=#simulator
POLL_INTERVAL=#5
MODBUS_TIMEOUT=#2
